{
  "name": "vanta",
  "version": "0.3.2",
  "private": true,
  "description": "VANTA - control de integridad de carpetas de juegos",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "test": "node pruebas/servicios.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "electron-builder": "^25.1.8"
  },
  "author": "Éber",
  "build": {
    "appId": "es.eber.vanta",
    "productName": "VANTA",
    "asar": false,
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VANTA-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VANTA",
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "repository": "github:Zoar87/vanta"
}
